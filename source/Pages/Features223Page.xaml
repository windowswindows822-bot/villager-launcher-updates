<Page
    x:Class="villagerlauncher.Pages.Features223Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Text="2.2.3 Feature Center"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="All 625 required ideas are compiled directly into C#."
                           Opacity="0.6"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="14,7"
                    CornerRadius="18"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TotalCountText"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search all 625 code-backed features..."
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="CategoryCombo"
                      Grid.Column="1"
                      SelectionChanged="CategoryCombo_SelectionChanged"/>

            <ComboBox x:Name="StatusCombo"
                      Grid.Column="2"
                      SelectionChanged="StatusCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="FeatureProgress"
                         Minimum="0"
                         Maximum="625"
                         Value="625"
                         Height="6"
                         VerticalAlignment="Center"/>

            <TextBlock x:Name="VisibleCountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Opacity="0.6"/>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="FeatureList"
                      SelectionMode="Single"
                      SelectionChanged="FeatureList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding IdText}"
                                           FontWeight="SemiBold"
                                           Opacity="0.55"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Category}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Status}"
                                           HorizontalAlignment="Right"
                                           Opacity="0.55"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1"
                    Padding="20"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Feature Detail"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="DetailIdText"
                                   Opacity="0.55"/>

                        <TextBlock x:Name="DetailTitleText"
                                   Text="Select a feature"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="DetailCategoryText"
                                   Opacity="0.6"
                                   TextWrapping="Wrap"/>

                        <Border Padding="12"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Implementation contract"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Every ID 001-625 exists in compiled C# and is required for 2.2.3. This page tracks the code-backed backlog so no ID disappears."
                                           TextWrapping="Wrap"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Random Feature"
                                HorizontalAlignment="Left"
                                Click="RandomFeature_Click"/>

                        <Button Content="Clear Filters"
                                HorizontalAlignment="Left"
                                Click="ClearFilters_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
