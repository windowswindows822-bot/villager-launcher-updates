
<Page
    x:Class="villagerlauncher.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="30" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Profiles" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="Separate Minecraft setups without mixing their choices."
                           Opacity="0.6"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Profile" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <ListView>
                <ListViewItem Content="Default"/>
                <ListViewItem Content="Create another profile…"/>
            </ListView>

            <Border Grid.Column="1"
                    Padding="22"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="11">
                    <TextBlock Text="Default"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBox Header="Profile Name" Text="Default"/>
                    <ComboBox Header="Default Loader" SelectedIndex="0">
                        <ComboBoxItem Content="Vanilla"/>
                        <ComboBoxItem Content="Fabric"/>
                        <ComboBoxItem Content="Forge"/>
                    </ComboBox>
                    <TextBox Header="Custom Game Directory"
                             PlaceholderText="Leave blank to use the normal .minecraft directory"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save Profile"/>
                        <Button Content="Duplicate"/>
                        <Button Content="Archive"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
