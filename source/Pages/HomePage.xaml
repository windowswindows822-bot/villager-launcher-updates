<Page
    x:Class="villagerlauncher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="34,28,34,36"
              MaxWidth="1080"
              HorizontalAlignment="Center">
            <StackPanel Spacing="22">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Good evening, Villager"
                                   FontSize="27"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Your Minecraft launcher is ready."
                                   FontSize="13"
                                   Opacity="0.56"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Browse Library"
                            Padding="18,9"
                            VerticalAlignment="Center"
                            Click="BrowseLibrary_Click"/>
                </Grid>

                <!-- One clean Quick Play bar.
                     Deliberately NO six instance tiles/icons. -->
                <Border Padding="16,12"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="16"/>
                            <TextBlock Text="Quick Play"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="22,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Default Profile"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Choose a Minecraft version first"
                                       FontSize="11"
                                       Opacity="0.54"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Play"
                                Padding="20,7"
                                Click="OpenPlay_Click"/>
                    </Grid>
                </Border>

                <!-- No Explore Content Hub image cards -->

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Servers -->
                    <StackPanel Grid.Column="0" Spacing="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Servers"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <Button Grid.Column="1"
                                    Content="Open"
                                    Padding="10,2"
                                    Click="OpenServers_Click"/>
                        </Grid>

                        <Border Padding="14"
                                CornerRadius="11"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="No favorite server selected"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Add servers from the Servers page."
                                               FontSize="11"
                                               Opacity="0.54"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="—"
                                           VerticalAlignment="Center"
                                           Opacity="0.45"/>
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                CornerRadius="11"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Server status"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="No ping data yet"
                                               FontSize="11"
                                               Opacity="0.54"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="Offline"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"/>
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                CornerRadius="11"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Recent connection"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Nothing recorded yet"
                                               FontSize="11"
                                               Opacity="0.54"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="—"
                                           VerticalAlignment="Center"
                                           Opacity="0.45"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Playtime -->
                    <StackPanel Grid.Column="1" Spacing="9">
                        <TextBlock Text="Your Playtime"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <Border Padding="18"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="0h 0m"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Last 7 days"
                                                   FontSize="11"
                                                   Opacity="0.5"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="No sessions yet"
                                                   FontSize="10"
                                                   Opacity="0.7"/>
                                    </Border>
                                </Grid>

                                <!-- lightweight chart, no image -->
                                <Grid Height="105"
                                      ColumnSpacing="10"
                                      VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Height="34"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <Border Grid.Column="1"
                                            Height="7"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"/>
                                    <Border Grid.Column="2"
                                            Height="22"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="3"
                                            Height="26"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="4"
                                            Height="8"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="5"
                                            Height="19"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="6"
                                            Height="5"
                                            CornerRadius="4"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="0m"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Average Session"
                                                   FontSize="10"
                                                   Opacity="0.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="0m"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Longest Session"
                                                   FontSize="10"
                                                   Opacity="0.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="0 of 7"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Days Played"
                                                   FontSize="10"
                                                   Opacity="0.5"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Small functional status area.
                     Deliberately NO big bottom image/news card. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="15"
                            CornerRadius="11"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Java"
                                       FontSize="11"
                                       Opacity="0.5"/>
                            <TextBlock Text="Not checked"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="15"
                            CornerRadius="11"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Minecraft"
                                       FontSize="11"
                                       Opacity="0.5"/>
                            <TextBlock Text="Ready to configure"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="15"
                            CornerRadius="11"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Launcher"
                                       FontSize="11"
                                       Opacity="0.5"/>
                            <TextBlock Text="WinUI 3 / x64"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>