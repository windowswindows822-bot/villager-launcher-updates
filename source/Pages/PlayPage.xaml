
<Page
    x:Class="villagerlauncher.Pages.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="30" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="18">
                <StackPanel>
                    <TextBlock Text="Play"
                               FontSize="32"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Build the launch session here, then launch with confidence."
                               Opacity="0.6"/>
                </StackPanel>

                <Border Padding="22"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Launch Configuration"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Profile"/>
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Default"/>
                        </ComboBox>
                        <TextBlock Text="Minecraft Version"/>
                        <ComboBox PlaceholderText="Choose an installed version"/>
                        <TextBlock Text="Loader"/>
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Vanilla"/>
                            <ComboBoxItem Content="Fabric"/>
                            <ComboBoxItem Content="Forge"/>
                            <ComboBoxItem Content="NeoForge"/>
                        </ComboBox>
                        <TextBlock Text="Memory"/>
                        <Slider Minimum="1" Maximum="16" Value="4" StepFrequency="1"/>
                    </StackPanel>
                </Border>

                <Button Content="Launch Minecraft"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="18,12"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Padding="20" CornerRadius="16" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Preflight"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Java" Opacity="0.55"/>
                        <TextBlock Text="Not checked"/>
                        <TextBlock Text="Minecraft files" Opacity="0.55" Margin="0,8,0,0"/>
                        <TextBlock Text="Not checked"/>
                        <TextBlock Text="Authentication" Opacity="0.55" Margin="0,8,0,0"/>
                        <TextBlock Text="Not connected"/>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="16" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Session"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="No active Minecraft session."
                                   TextWrapping="Wrap"
                                   Opacity="0.65"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
