
<Page
    x:Class="villagerlauncher.Pages.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="30" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="News &amp; Updates" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="Connected to the Villager Launcher GitHub update source."
                               Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Open GitHub" Click="OpenGitHub_Click"/>
                    <Button Content="Check for Updates" Click="CheckUpdate_Click"/>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="UpdateInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Launcher 2.2.2"
                     Message="Press Check for Updates to read version.json from GitHub."/>

            <Border Padding="22"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Release Notes"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReleaseNotesText"
                               Text="GitHub release information will appear here."
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <Border Padding="22"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Update Architecture"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Current source: windowswindows822-bot/villager-launcher-updates. Future compiled C# releases can publish an installer URL and SHA-256 hash in version.json."
                               TextWrapping="Wrap"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
