
<Page
    x:Class="villagerlauncher.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="30" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Servers" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="Favorites, status, notes, history, and quick join."
                       Opacity="0.6"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Server address" FlowDirection="LeftToRight"/>
                <TextBox Grid.Column="1" PlaceholderText="Nickname"/>
                <Button Grid.Column="2" Content="Add Server"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <Border Padding="20" CornerRadius="16" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Saved Servers" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="No redesigned server entries yet."
                               Margin="0,10,0,0"
                               Opacity="0.65"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="20" CornerRadius="16" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Server Inspector" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Future status: online state, ping, MOTD, version, player count, and notes."
                               TextWrapping="Wrap"
                               Opacity="0.65"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
