<Page
    x:Class="villagerlauncher.Pages.ThemeGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <TextBlock Text="Theme Gallery"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="100 launcher themes, including Aero Glass."
                           Opacity="0.6"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="14,7"
                    CornerRadius="18"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="100 themes"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search themes..."
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="CategoryCombo"
                      Grid.Column="1"
                      SelectionChanged="CategoryCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="ThemeList"
                      SelectionMode="Single"
                      SelectionChanged="ThemeList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding IdText}"
                                           Opacity="0.55"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Category}"
                                           Opacity="0.6"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding GlassText}"
                                           HorizontalAlignment="Right"
                                           Opacity="0.6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1"
                    Padding="20"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Theme Preview"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ThemeNameText"
                               Text="Select a theme"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="ThemeCategoryText"
                               Opacity="0.6"/>

                    <Border x:Name="PreviewCard"
                            Height="150"
                            CornerRadius="16"
                            BorderThickness="1">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock x:Name="PreviewTitle"
                                           Text="Villager Launcher"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <Button x:Name="PreviewButton"
                                        Content="Play Minecraft"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ThemeModeText"
                               TextWrapping="Wrap"
                               Opacity="0.62"/>

                    <Button Content="Apply Preview"
                            Click="ApplyPreview_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
