<Page
    x:Class="villagerlauncher.Pages.MasterFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Master Feature Pool"
                           FontSize="32"
                           FontWeight="SemiBold"/>
                <TextBlock Text="The full Villager Launcher 2.2.2+ idea catalog, installed in safe batches."
                           Opacity="0.62"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="LoadedCountText"
                           HorizontalAlignment="Right"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="BatchCountText"
                           HorizontalAlignment="Right"
                           Opacity="0.55"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search the master pool..."
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="CategoryCombo"
                      Grid.Column="1"
                      SelectionChanged="CategoryCombo_SelectionChanged"/>

            <ComboBox x:Name="BatchCombo"
                      Grid.Column="2"
                      SelectionChanged="BatchCombo_SelectionChanged"/>

            <Button Grid.Column="3"
                    Content="Random"
                    Click="Random_Click"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="InstallProgress"
                         Minimum="0"
                         Maximum="1501"
                         Height="6"
                         VerticalAlignment="Center"/>

            <TextBlock x:Name="ResultCountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Opacity="0.62"/>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="FeatureList"
                      SelectionMode="Single"
                      SelectionChanged="FeatureList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding MasterIdLabel}"
                                           FontWeight="SemiBold"
                                           Opacity="0.55"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Category}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"/>

                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding SourceNumberLabel}"
                                                   FontSize="11"
                                                   Opacity="0.5"/>
                                        <TextBlock Text="{Binding BatchLabel}"
                                                   FontSize="11"
                                                   Opacity="0.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1"
                    Padding="20"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Feature Detail"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="DetailIdText"
                                   Opacity="0.5"/>

                        <TextBlock x:Name="DetailTitleText"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="DetailCategoryText"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"/>

                        <Border Margin="0,8,0,0"
                                Padding="12"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Release state"
                                           FontSize="11"
                                           Opacity="0.55"/>
                                <TextBlock Text="Master backlog entry"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="This catalog records the requested feature. Functional implementation is connected page-by-page so unfinished systems are never falsely reported as complete."
                                           TextWrapping="Wrap"
                                           Opacity="0.65"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Clear filters"
                                Click="ClearFilters_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
