<Window
    x:Class="villagerlauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Villager Launcher 2.2.2">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="LeftCompact"
                        IsPaneOpen="False"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        CompactPaneLength="58"
                        OpenPaneLength="220"
                        AlwaysShowHeader="False"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <NavigationView.MenuItems>

                <NavigationViewItem x:Name="HomeNavItem"
                                    Content="Home"
                                    Tag="Home"
                                    ToolTipService.ToolTip="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Play"
                                    Tag="Play"
                                    ToolTipService.ToolTip="Play">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Profiles"
                                    Tag="Profiles"
                                    ToolTipService.ToolTip="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Versions"
                                    Tag="Versions"
                                    ToolTipService.ToolTip="Versions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Mods"
                                    Tag="Mods"
                                    ToolTipService.ToolTip="Mods">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Modpacks"
                                    Tag="Modpacks"
                                    ToolTipService.ToolTip="Modpacks and Packs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Worlds"
                                    Tag="Worlds"
                                    ToolTipService.ToolTip="Worlds">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Servers"
                                    Tag="Servers"
                                    ToolTipService.ToolTip="Servers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="News"
                                    Tag="News"
                                    ToolTipService.ToolTip="News">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Tools"
                                    Tag="Tools"
                                    ToolTipService.ToolTip="Tools and Diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Master Feature Pool"
                                    Tag="MasterFeatures"
                                    ToolTipService.ToolTip="Master Feature Pool">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            
                <NavigationViewItem Content="2.2.3 Features"
                                    Tag="Features223">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            
                <NavigationViewItem Content="Themes"
                                    Tag="Themes223">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"
                                  FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings"
                                    Tag="Settings"
                                    ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Simple title strip -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid Padding="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="9"
                                    VerticalAlignment="Center">
                            <TextBlock Text="V"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock Text="Villager Launcher"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <Border Padding="6,2"
                                    CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="2.2.2"
                                           FontSize="10"
                                           Opacity="0.72"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Check Updates"
                                    Click="CheckUpdates_Click"/>
                            <Button Content="Settings"
                                    Click="OpenSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="286"/>
                    </Grid.ColumnDefinitions>

                    <!-- Every nav destination fully replaces this center content -->
                    <Frame x:Name="ContentFrame"
                           Grid.Column="0"/>

                    <!-- Slim persistent right rail like the reference, but no photos -->
                    <Border Grid.Column="1"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid Padding="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Launcher"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <Button Grid.Column="1"
                                        Content="↻"
                                        Padding="8,2"
                                        Click="RefreshSidePanel_Click"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Update Status"
                                               FontSize="11"
                                               Opacity="0.55"/>
                                    <TextBlock Text="Villager Launcher 2.2.2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Use Check Updates to query GitHub."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Opacity="0.62"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2"
                                    Margin="0,12,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Active Profile"
                                               FontSize="11"
                                               Opacity="0.55"/>
                                    <TextBlock Text="Default"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Minecraft version not selected"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Opacity="0.62"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Padding="14"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Villager Bot"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Launcher help, diagnostics, and Minecraft tools will live here."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Opacity="0.62"/>
                                    <Button Content="Open Tools"
                                            HorizontalAlignment="Left"
                                            Click="OpenTools_Click"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,14,0,0">
                                <Button Content="GitHub"
                                        Click="GitHub_Click"/>
                                <Button Content="Logs"
                                        Click="OpenTools_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>